PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# Existing CIELingo native state ABI remains unchanged.
OP PNAML10.CIEL.SOURCE SOURCE CIEL_NATIVE_SEMANTIC_STATE_V1
OP PNAML10.CIEL.READ SOURCE CIEL_MEMORY_READ_SET_V1
OP PNAML10.CIEL.PLAN SOURCE CIEL_NATIVE_SURFACE_PLAN_V2
OP PNAML10.CIEL.SOURCE.IDENTITY IDENTITY PNAML10.CIEL.SOURCE
OP PNAML10.CIEL.CONTEXT COMPOSITION PNAML10.CIEL.SOURCE.IDENTITY PNAML10.CIEL.READ PNAML10.CIEL.PLAN
OP PNAML10.CIEL.BIND TRANSFORM PNAML10.CIEL.CONTEXT typed_pncs_semantic_identity_and_spinor4pi
ASSERT PNAML10.CIEL.SOURCE.IDENTITY
EMIT PNAML10.CIEL.BIND
# CONTRACT No changes to CIELingo ABI, schema, or native authority.
# CONTRACT spinor exp(i*phi/2) and 4*pi is kept distinct from torus 2*pi.
